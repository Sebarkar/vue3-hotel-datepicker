{
  "name": "@sebarkar/vue3-hotel-datepicker",
  "homepage": "https://vue3-hotel-datepicker.sebarkar.tech",
  "private": false,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebarkar/vue3-hotel-datepicker.git"
  },
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    },
    "./dist/style.css": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "keywords": [
    "datepicker",
    "vue3-datepicker",
    "hotel-datepicker",
    "vue3",
    "vue",
    "vuejs"
  ],
  "files": [
    "dist",
    "src/components/"
  ],
  "dependencies": {
    "fecha": "^4.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0 || ^3.5.0"
  },
  "devDependencies": {
    "@highlightjs/vue-plugin": "^2.1.0",
    "@iconify/vue": "^4.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "date-fns": "^3.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  }
}
